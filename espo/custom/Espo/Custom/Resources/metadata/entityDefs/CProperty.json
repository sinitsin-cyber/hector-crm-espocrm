{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "status": {
            "type": "enum",
            "options": [
                "Free",
                "Reserved",
                "Contract",
                "Construction",
                "Delivered",
                "Unavailable"
            ],
            "default": "Free",
            "required": true,
            "style": {
                "Free": "success",
                "Reserved": "warning",
                "Contract": "danger",
                "Construction": "info",
                "Delivered": "primary",
                "Unavailable": "default"
            },
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "propertyType": {
            "type": "enum",
            "options": [
                "House",
                "Plot",
                "Townhouse",
                "Apartment"
            ],
            "default": "House",
            "maxLength": 100,
            "isCustom": true
        },
        "row": {
            "type": "int",
            "required": true,
            "default": 1,
            "min": -5,
            "max": 200,
            "isCustom": true,
            "tooltip": true
        },
        "position": {
            "type": "int",
            "required": true,
            "default": 1,
            "min": 1,
            "max": 500,
            "isCustom": true,
            "tooltip": true
        },
        "area": {
            "notNull": false,
            "type": "float",
            "min": 0,
            "decimalPlaces": 1,
            "isCustom": true
        },
        "plotArea": {
            "notNull": false,
            "type": "float",
            "min": 0,
            "decimalPlaces": 2,
            "isCustom": true
        },
        "price": {
            "type": "currency",
            "audited": true,
            "isCustom": true
        },
        "reservedUntil": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "housingProject": {
            "type": "link"
        },
        "contact": {
            "type": "link"
        },
        "opportunity": {
            "type": "link"
        },
        "entrance": {
            "type": "int",
            "min": 1,
            "max": 100,
            "isCustom": true,
            "tooltip": true
        },
        "rooms": {
            "type": "enum",
            "options": [
                "",
                "studio",
                "1",
                "2",
                "3",
                "4"
            ],
            "default": "",
            "maxLength": 100,
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "housingProject": {
            "type": "belongsTo",
            "foreign": "properties",
            "entity": "CHousingProject",
            "audited": false,
            "isCustom": true
        },
        "contact": {
            "type": "belongsTo",
            "foreign": "cProperties",
            "entity": "Contact",
            "audited": false,
            "isCustom": true
        },
        "opportunity": {
            "type": "belongsTo",
            "foreign": "cProperties",
            "entity": "Opportunity",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "name",
        "order": "asc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        },
        "chessboard": {
            "columns": [
                "housingProjectId",
                "entrance",
                "row",
                "position"
            ]
        }
    }
}
